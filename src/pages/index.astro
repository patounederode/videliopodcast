	<!-- filter java -->
<script>
    const knoppen = document.querySelectorAll(".filters button");
    const podcasts = document.querySelectorAll(".podcast");

    knoppen.forEach(function (knop) {
        knop.addEventListener("click", function () {
            const filter = knop.getAttribute("value") || "all";

            knoppen.forEach(function (k) {
                k.classList.remove("active");
            });

            knop.classList.add("active");

            podcasts.forEach(function (podcast) {
                if (filter === "all" || podcast.classList.contains(filter)) {
                    podcast.classList.remove("hidden");
                } else {
                    podcast.classList.add("hidden");
                }
            });
        });
    });
</script>

	<style>

		/* hero */

